{
  "name": "appweb-clima",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "docs:screenshots": "node scripts/capture-readme-screenshots.mjs",
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc -b && vite build && npm run build:server",
    "build:client": "tsc -b && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:performance": "node scripts/check-performance-budget.mjs",
    "test:pwa": "node scripts/check-pwa-build.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "animejs": "^4.5.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-globe.gl": "^2.38.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.62.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.61.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
