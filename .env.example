# Copia este archivo a .env y completa los valores. .env nunca se sube (ver .gitignore).

# Resumen inteligente del clima (M2). Sin esta key, el backend responde con
# un resumen "no disponible" pero el resto de la app sigue funcionando igual.
ANTHROPIC_API_KEY=

# Opcional. Modelo rápido/económico vigente y verificado en la documentación
# oficial de Anthropic el 2026-08-02.
AI_SUMMARY_MODEL=claude-haiku-4-5-20251001

# Opcionales para desarrollo local.
PORT=3001
VITE_API_BASE_URL=http://127.0.0.1:3001
